{
  "mcpServers": {
    "knowledge-based-search": {
      "command": "__KBS_PYTHON__",
      "args": ["__KBS_SERVER__"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __KBS_DIR__/hooks/session_start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __KBS_DIR__/hooks/prompt_inject.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__knowledge-based-search__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __KBS_DIR__/hooks/method_inject.py"
          }
        ]
      }
    ]
  }
}
