{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "python3 __KBS_DIR__/hooks/session_start.py" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "python3 __KBS_DIR__/hooks/prompt_inject.py" }]
      }
    ]
  }
}
